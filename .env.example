# =============================================================
# TikTok Backend — Local dev environment variables
# Copy this file to .env and adjust if needed:
#   cp .env.example .env
#
# .env is gitignored. This file (.env.example) IS committed and must be
# kept in sync whenever a service adds a new ${VAR:default} placeholder
# in its application.yml.
#
# IMPORTANT: JWT_SECRET must be IDENTICAL across every service — it's the
# shared HMAC key auth-service uses to sign tokens and every other service
# (via security-lib) uses to validate them. Changing it here changes it
# everywhere at once, which is the point.
#
# Production/staging must NOT use this file — inject real secrets via your
# deployment platform's secret manager (Kubernetes Secret, ECS task env,
# Vault, etc.) instead.
# =============================================================

# --- Postgres (shared by auth/user/product/cart/order/payment/inventory/admin) ---
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- MongoDB (video/story/chat/notification service) ---
MONGO_USERNAME=root
MONGO_PASSWORD=password

# --- JWT (shared secret — see note above) ---
JWT_SECRET=change-this-secret-in-production-please-0123456789

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Redis (cart-service, interaction-service) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Cassandra (interaction-service) ---
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DC=dc1

# --- Elasticsearch (search-service) ---
ELASTICSEARCH_URIS=http://localhost:9200

# --- ClickHouse (analytics-service) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# --- MinIO (media-worker) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=video-media

# --- Firebase Cloud Messaging (notification-service) ---
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# --- Inter-service HTTP URLs (cart-service -> product-service, etc.) ---
AUTH_SERVICE_URI=http://localhost:8081
USER_SERVICE_URI=http://localhost:8082
VIDEO_SERVICE_URI=http://localhost:8083
INTERACTION_SERVICE_URI=http://localhost:8085
PRODUCT_SERVICE_URL=http://localhost:8090
CART_SERVICE_URL=http://localhost:8091
