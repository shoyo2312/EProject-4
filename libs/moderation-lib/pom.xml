<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tiktok</groupId>
        <artifactId>tiktok-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>moderation-lib</artifactId>
    <packaging>jar</packaging>
    <name>moderation-lib</name>

    <!--
        Text hygiene and rule-based text moderation, shared by every service that stores text a
        viewer will read. Auto-configured via META-INF/spring/...AutoConfiguration.imports: a
        service adds the dependency and injects TextModerator, nothing else.

        1. TextSanitizer and @MaxCodePoints: the stored form of a text, and its length counted the
           way a reader counts it.
        2. TextModerator: a Vietnamese blocklist and spam signals, deciding ALLOW / HOLD / REJECT.
           See docs/superpowers/specs/2026-10-13-text-moderation-design.md.
        3. TextClassifier and AdminTermsSync: moderation-service's text classifier behind the rules,
           and admin-service's terms on top of the shipped list. See
           docs/superpowers/specs/2026-10-14-text-moderation-phase2-design.md.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- @MaxCodePoints. The API only: every consuming service already has Hibernate Validator
             through spring-boot-starter-validation. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- The decision counter. Recorded on the global registry, which actuator binds its own to. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!-- Provided: PooledRequestFactory, InternalApiToken and ApiResponse for the two HTTP clients.
             Every service on this lib already has common-lib, which brings JPA and web along, so it
             is not pulled in from here. -->
        <dependency>
            <groupId>com.tiktok</groupId>
            <artifactId>common-lib</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Provided: RestClient, and the JSON it reads and writes. Every consuming service is a web
             application; the clients' configuration is @ConditionalOnClass(RestClient). -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Provided: every consuming service already has slf4j-api via spring-boot-starter-logging. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MaxCodePointsTest runs the constraint through a real validator. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
